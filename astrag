def _set_proc_name(name: bytes = b"astrag\x00") -> None:
    try:
        libc = ctypes.CDLL("libc.so.6")
        libc.prctl(15, name, 0, 0, 0)
    except Exception:
        pass


def _default_runtime_dir() -> Path:
    if os.environ.get("ASTRA_RUNTIME_DIR"):
        return Path(os.environ["ASTRA_RUNTIME_DIR"])
    opt_dir = Path("/opt/astrag")
    if os.geteuid() == 0 or (opt_dir.exists() and os.access(opt_dir, os.W_OK)):
        return opt_dir
    if opt_dir.joinpath(".bundle_sha256").exists():
        try:
            if opt_dir.joinpath(".bundle_sha256").read_text().strip() == PAYLOAD_SHA256:
                return opt_dir
        except OSError:
            pass
    var_dir = Path("/var/lib/astrag/runtime")
    if var_dir.exists() and os.access(var_dir, os.W_OK):
        return var_dir
    return Path(tempfile.gettempdir()) / f"astrag-runtime-{os.getuid()}"


def ensure_runtime_extracted(target_dir: Path = None) -> Path:
    rdir = target_dir or _default_runtime_dir()
    stamp = rdir / ".bundle_sha256"
    backend_py = rdir / "astra_clone_backend.py"
    index_html = rdir / "www" / "index.html"
    if stamp.exists() and backend_py.exists() and index_html.exists():
        try:
            if stamp.read_text(encoding="utf-8").strip() == PAYLOAD_SHA256:
                return rdir
        except OSError:
            pass
    rdir.mkdir(parents=True, exist_ok=True)
    raw_lzma = base64.b64decode(PAYLOAD_B64)
    if hashlib.sha256(raw_lzma).hexdigest() != PAYLOAD_SHA256:
        raise RuntimeError("AstraG embedded payload checksum mismatch")
    raw_tar = lzma.decompress(raw_lzma)
    with tarfile.open(fileobj=io.BytesIO(raw_tar), mode="r") as tf:
        try:
            tf.extractall(path=rdir, filter="data")
        except TypeError:
            tf.extractall(path=rdir)
    stamp.write_text(PAYLOAD_SHA256 + "\n", encoding="utf-8")
    return rdir


def ensure_apt_dependencies() -> None:
    try:
        import fastapi  # noqa: F401
        import uvicorn  # noqa: F401
        import pydantic  # noqa: F401
        return
    except ImportError:
        pass
