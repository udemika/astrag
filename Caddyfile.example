# Replace media.example.com with your real domain pointing to the server.
# Caddy obtains/renews TLS certificates; inbound TCP 80/443 must be reachable.
media.example.com {
    encode gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "same-origin"
    }
    reverse_proxy 127.0.0.1:8000
}
