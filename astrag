    was_active = subprocess.run(
        ["systemctl", "is-active", "--quiet", f"{service_name}.service"], check=False
    ).returncode == 0
    if auto_start or was_active:
        subprocess.run(["systemctl", "enable", f"{service_name}.service"], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run(["systemctl", "restart", f"{service_name}.service"], check=False)
        print(f"[AstraG] Сервис '{service_name}' запущен и добавлен в автозагрузку.")
    else:
        print("Для запуска и добавления в автозагрузку выполните:")
        print(f"  systemctl start {service_name}")
        print(f"  systemctl enable {service_name}")
    return 0


def cmd_remove(argv: list) -> int:
    if os.geteuid() != 0:
        print("Ошибка: команда 'astrag remove' требует прав root (используйте sudo).", file=sys.stderr)
        return 1

    target_arg = None
    purge = False
    for a in argv:
        if a in ("--purge", "-P", "purge"):
            purge = True
        elif not a.startswith("-"):
            target_arg = a

    if target_arg is None:
        service_name = "astrag"
    elif target_arg.isdigit():
        service_name = "astrag" if int(target_arg) == 8000 else f"astrag{target_arg}"
    else:
        service_name = target_arg

    unit_name = f"{service_name}.service"
    subprocess.run(["systemctl", "stop", unit_name], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(["systemctl", "disable", unit_name], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    unit_path = Path(f"/etc/systemd/system/{unit_name}")
    if unit_path.exists():
        unit_path.unlink()
    subprocess.run(["systemctl", "daemon-reload"], check=False)
    subprocess.run(["systemctl", "reset-failed"], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    print(f"[AstraG] Сервис '{service_name}' остановлен и удален из systemd.")

    if purge:
        if target_arg is not None and service_name != "astrag":
            conf_p = Path(f"/etc/astrag/{service_name}.conf")
            if conf_p.exists():
                conf_p.unlink()
            print(f"[AstraG] Конфигурационный файл {conf_p} удален.")
        else:
            for unit_p in Path("/etc/systemd/system").glob("astrag*.service"):
                u_name = unit_p.name
                subprocess.run(["systemctl", "stop", u_name], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                subprocess.run(["systemctl", "disable", u_name], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                unit_p.unlink(missing_ok=True)
            subprocess.run(["pkill", "-f", "/opt/astrag/astrag-core"], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            subprocess.run(["pkill", "-f", "astra_clone_backend.py"], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            subprocess.run(["systemctl", "daemon-reload"], check=False)
            for d in (Path("/opt/astrag"), Path("/etc/astrag"), Path("/var/lib/astrag"), Path("/var/log/astrag")):
                if d.exists():
                    shutil.rmtree(d, ignore_errors=True)
            subprocess.run(["userdel", "astrag"], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            for b in (Path("/usr/bin/astrag"), Path("/usr/bin/astra-clone")):
                if b.exists():
                    try:
                        b.unlink()
                    except OSError:
                        pass
            print("[AstraG] Все файлы (/opt/astrag, /etc/astrag, /var/lib/astrag, /usr/bin/astrag) полностью удалены.")
    return 0


def cmd_reset_password(argv: list) -> int:
    rdir = ensure_runtime_extracted()
    conf_path = Path(os.environ.get("ASTRA_CONFIG_FILE", "/etc/astrag/astrag.conf"))
    pos = []
    i = 0
    while i < len(argv):
        if argv[i] in ("-c", "--config") and i + 1 < len(argv):
            conf_path = Path(argv[i + 1])
            i += 2
        else:
            pos.append(argv[i])
            i += 1
    login = pos[0] if len(pos) >= 1 else "admin"
    password = pos[1] if len(pos) >= 2 else "admin"
    if not conf_path.parent.exists():
        conf_path = rdir / "astrag.conf"
    conf_path.parent.mkdir(parents=True, exist_ok=True)
    data = {}
    if conf_path.exists():
        try:
            raw = conf_path.read_text(encoding="utf-8-sig").strip()
            if raw.startswith("{"):
                data = json.loads(raw)
        except Exception:
            data = {}
    cfg = data.get("config") if isinstance(data.get("config"), dict) else data
    if not isinstance(cfg, dict):
        cfg = {}
    cfg.setdefault("port", 8000)
    cfg.setdefault("host", "0.0.0.0")
    cfg.setdefault("gid", 466560)
    cfg.setdefault("auth", {})["enable"] = True
    users = cfg.setdefault("users", {})
    users[login] = {
        "type": 1,
        "role": "admin",
        "enable": True,
        "password": password,
        "created": int(time.time()),
    }
    cfg.setdefault("make_stream", [])
    cfg.setdefault("categories", [])
    cfg.setdefault("servers", [])
    cfg.setdefault("softcam", [])
    cfg.setdefault("cas", [])
    cfg.setdefault("dvb_tune", [])
    cfg.setdefault("settings", {})
    cfg.setdefault("hls", {})
    conf_path.write_text(json.dumps(cfg, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    os.chmod(conf_path, 0o640)
    print(f"[AstraG] Учетная запись '{login}' (пароль '{password}') сохранена в {conf_path}.")
    return 0


def print_help() -> None:
    print(
        f"AstraG v{VERSION} — Cesbo Astra-compatible MPEG-TS / HLS Broadcast Server\n\n"
        "Использование:\n"
        "  astrag init [port] [name] [--start]    Создать конфиг /etc/astrag/astrag[port].conf и сервис systemd\n"
        "  astrag remove [port|name] [--purge]    Удалить сервис systemd (с --purge удаляет конфиги и файлы)\n"
        "  astrag -c <config> [-p <port>]         Запустить сервер вещания и веб-панель напрямую\n"
        "  astrag reset-password [user] [pass]    Сбросить логин и пароль в /etc/astrag/astrag.conf\n"
        "  astrag -v, --version                   Показать версию AstraG\n"
        "  astrag -h, --help                      Показать эту справку"
    )


def main() -> int:
    _set_proc_name(b"astrag\x00")
    argv = sys.argv[1:]
    if argv:
        cmd = argv[0]
        if cmd in ("-v", "--version", "version"):
            print(f"AstraG {VERSION}")
            return 0
        if cmd in ("-h", "--help", "help"):
            print_help()
            return 0
        if cmd == "init":
            return cmd_init(argv[1:])
        if cmd in ("remove", "uninstall"):
            return cmd_remove(argv[1:])
        if cmd == "purge":
            return cmd_remove(["--purge"] + argv[1:])
        if cmd == "reset-password":
            return cmd_reset_password(argv[1:])

    rdir = ensure_runtime_extracted()
    sys.path.insert(0, str(rdir))
    os.environ.setdefault("ASTRA_STATIC_DIR", str(rdir / "www"))
    if "-c" not in argv and "--config" not in argv and Path("/etc/astrag/astrag.conf").exists():
        os.environ.setdefault("ASTRA_CONFIG_FILE", "/etc/astrag/astrag.conf")
        os.environ.setdefault("ASTRA_STATE_FILE", "/etc/astrag/astrag.conf")

    import astra_clone_backend
    return astra_clone_backend.main()


if __name__ == "__main__":
    raise SystemExit(main())
