#!/usr/bin/env python3
"""AstraG Standalone Executable & Installer (Cesbo Astra-compatible).

Single-file distribution containing the complete AstraG MPEG-TS/HLS broadcast
engine, FastAPI/Uvicorn management server, security module, and Web UI.

Usage (Cesbo Astra compatible):
  curl -Lo /usr/bin/astrag https://raw.githubusercontent.com/udemika/astrag/main/astrag
  chmod +x /usr/bin/astrag
  astrag init [port] [service-name] [--binary]
  systemctl start astrag
  systemctl enable astrag

Removal:
  systemctl stop astrag
  systemctl disable astrag
  astrag remove [service-name] [--purge]
  rm -f /usr/bin/astrag
"""
import base64
import ctypes
import grp
import hashlib
import io
import json
import lzma
import os
import pwd
import shutil
import subprocess
import sys
import tarfile
import tempfile
import time
from pathlib import Path

VERSION = "2.0.0"
PAYLOAD_SHA256 = "73f3fdc3ee4e4c7201dff36d9dee73613c7b4b77f33740f08957379c8638ad8f"
PAYLOAD_B64 = """"""
def _set_proc_name(name: bytes = b"astrag\x00") -> None:
    try:
        libc = ctypes.CDLL("libc.so.6")
        libc.prctl(15, name, 0, 0, 0)
    except Exception:
        pass


def _default_runtime_dir() -> Path:
    if os.environ.get("ASTRA_RUNTIME_DIR"):
        return Path(os.environ["ASTRA_RUNTIME_DIR"])
    opt_dir = Path("/opt/astrag")
    if os.geteuid() == 0 or (opt_dir.exists() and os.access(opt_dir, os.W_OK)):
        return opt_dir
    if opt_dir.joinpath(".bundle_sha256").exists():
        try:
            if opt_dir.joinpath(".bundle_sha256").read_text().strip() == PAYLOAD_SHA256:
                return opt_dir
        except OSError:
            pass
    var_dir = Path("/var/lib/astrag/runtime")
    if var_dir.exists() and os.access(var_dir, os.W_OK):
        return var_dir
    return Path(tempfile.gettempdir()) / f"astrag-runtime-{os.getuid()}"


def ensure_runtime_extracted(target_dir: Path = None) -> Path:
    rdir = target_dir or _default_runtime_dir()
    stamp = rdir / ".bundle_sha256"
    backend_py = rdir / "astra_clone_backend.py"
    index_html = rdir / "www" / "index.html"
    if stamp.exists() and backend_py.exists() and index_html.exists():
        try:
            if stamp.read_text(encoding="utf-8").strip() == PAYLOAD_SHA256:
                return rdir
        except OSError:
            pass
    rdir.mkdir(parents=True, exist_ok=True)
    raw_lzma = base64.b64decode(PAYLOAD_B64)
    if hashlib.sha256(raw_lzma).hexdigest() != PAYLOAD_SHA256:
        raise RuntimeError("AstraG embedded payload checksum mismatch")
    raw_tar = lzma.decompress(raw_lzma)
    for busy_bin in (rdir / "astrag-core", rdir / "astrag-bin"):
        try:
            if busy_bin.exists():
                busy_bin.unlink()
        except OSError:
            pass
    with tarfile.open(fileobj=io.BytesIO(raw_tar), mode="r") as tf:
        try:
            tf.extractall(path=rdir, filter="data")
        except TypeError:
            tf.extractall(path=rdir)
    core_bin = rdir / "astrag-core"
    if core_bin.exists():
        try:
            os.chmod(core_bin, 0o755)
        except OSError:
            pass
    stamp.write_text(PAYLOAD_SHA256 + "\n", encoding="utf-8")
    return rdir


def ensure_apt_dependencies() -> None:
    try:
        import fastapi  # noqa: F401
        import uvicorn  # noqa: F401
        import pydantic  # noqa: F401
        return
    except ImportError:
        pass
    if os.geteuid() != 0:
        print("[AstraG] Отсутствуют системные пакеты python3-fastapi / python3-uvicorn.", file=sys.stderr)
        print("[AstraG] Запустите: sudo astrag init", file=sys.stderr)
        sys.exit(1)
    print("[AstraG] Установка системных пакетов Ubuntu (apt без pip и без venv)...")
    env = os.environ.copy()
    env["DEBIAN_FRONTEND"] = "noninteractive"
    subprocess.run(["apt-get", "update", "-qq"], env=env, check=True)
    apt_pkgs = [
        "python3",
        "python3-fastapi",
        "python3-uvicorn",
        "python3-pydantic",
        "python3-starlette",
        "python3-anyio",
        "python3-h11",
        "python3-click",
        "python3-websockets",
        "python3-wsproto",
        "python3-multipart",
    ]
    res = subprocess.run(["apt-get", "install", "-y", "--no-install-recommends"] + apt_pkgs, env=env)
    if res.returncode != 0:
        subprocess.run(
            ["apt-get", "install", "-y", "python3", "python3-fastapi", "python3-uvicorn", "python3-pydantic"],
            env=env,
            check=True,
        )


def _ensure_system_user(user: str = "astrag") -> None:
    try:
        pwd.getpwnam(user)
    except KeyError:
        subprocess.run(
            ["useradd", "--system", "--home-dir", "/var/lib/astrag", "--shell", "/usr/sbin/nologin", user],
            check=False,
        )


def _chown_tree(path: Path, user: str = "astrag") -> None:
    try:
        uid = pwd.getpwnam(user).pw_uid
        gid = grp.getgrnam(user).gr_gid
    except KeyError:
        return
    for root, dirs, files in os.walk(path):
        try:
            os.chown(root, uid, gid)
        except OSError:
            pass
        for d in dirs:
            try:
                os.chown(os.path.join(root, d), uid, gid)
            except OSError:
                pass
        for f in files:
            try:
                os.chown(os.path.join(root, f), uid, gid)
            except OSError:
                pass


def cmd_init(argv: list) -> int:
    if os.geteuid() != 0:
        print("Ошибка: команда 'astrag init' требует прав root (используйте sudo).", file=sys.stderr)
        return 1

    port = 8000
    custom_name = None
    build_binary = False
    auto_start = False

    pos_args = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-p", "--port") and i + 1 < len(argv):
            port = int(argv[i + 1])
            i += 2
        elif a == "--binary":
            build_binary = True
            i += 1
        elif a in ("--start", "--now"):
            auto_start = True
            i += 1
        elif a.startswith("-"):
            i += 1
        else:
            pos_args.append(a)
            i += 1

    for pa in pos_args:
        if pa.isdigit():
            port = int(pa)
        else:
            custom_name = pa

    if custom_name:
        service_name = custom_name
    else:
        service_name = "astrag" if port == 8000 else f"astrag{port}"

    self_path = Path(__file__).resolve()
    usr_bin = Path("/usr/bin/astrag")
    if self_path != usr_bin:
        tmp_usr_bin = usr_bin.with_suffix(".new")
        shutil.copy2(self_path, tmp_usr_bin)
        os.chmod(tmp_usr_bin, 0o755)
        tmp_usr_bin.replace(usr_bin)
    else:
        os.chmod(usr_bin, 0o755)

    ensure_apt_dependencies()
    _ensure_system_user("astrag")

    opt_dir = Path("/opt/astrag")
    etc_dir = Path("/etc/astrag")
    var_dir = Path("/var/lib/astrag")
    opt_dir.mkdir(parents=True, exist_ok=True)
    etc_dir.mkdir(parents=True, exist_ok=True)
    var_dir.mkdir(parents=True, exist_ok=True)

    ensure_runtime_extracted(opt_dir)
    sys.path.insert(0, str(opt_dir))
    from account_security import verify_password

    conf_file = etc_dir / f"{service_name}.conf"
    legacy_state_file = var_dir / "state.json"

    default_cfg = {
        "port": port,
        "host": "0.0.0.0",
        "gid": 466560,
        "auth": {"enable": True},
        "users": {
            "admin": {
                "type": 1,
                "role": "admin",
                "enable": True,
                "password": "admin",
                "created": int(time.time()),
            }
        },
        "make_stream": [],
        "categories": [],
        "servers": [],
        "softcam": [],
        "cas": [],
        "dvb_tune": [],
        "settings": {},
        "hls": {},
    }

    existing_json = None
    if conf_file.exists():
        raw_conf = conf_file.read_text(encoding="utf-8-sig").strip()
        if raw_conf.startswith("{"):
            try:
                parsed = json.loads(raw_conf)
                if isinstance(parsed, dict):
                    existing_json = parsed.get("config") if isinstance(parsed.get("config"), dict) else parsed
            except Exception:
                existing_json = None

    # Migrate legacy /var/lib/astrag/state.json ONLY for the primary 'astrag' (8000) instance
    if existing_json is None and service_name == "astrag" and legacy_state_file.exists():
        try:
            st_raw = legacy_state_file.read_text(encoding="utf-8-sig").strip()
            st_parsed = json.loads(st_raw) if st_raw else {}
            if isinstance(st_parsed, dict):
                existing_json = st_parsed.get("config") if isinstance(st_parsed.get("config"), dict) else st_parsed
        except Exception:
            existing_json = None

    if isinstance(existing_json, dict):
        merged_cfg = dict(default_cfg)
        merged_cfg.update(existing_json)
        merged_cfg["port"] = port
        merged_cfg.pop("control_port", None)
        if isinstance(merged_cfg.get("users"), dict):
            for uinfo in merged_cfg["users"].values():
                if isinstance(uinfo, dict):
                    pw = uinfo.get("password", "")
                    if isinstance(pw, str) and pw.startswith("pbkdf2_sha256$") and verify_password("admin", pw):
                        uinfo["password"] = "admin"
        ordered_cfg = {
            "port": merged_cfg["port"],
            "host": merged_cfg.get("host", "0.0.0.0"),
            "gid": merged_cfg.get("gid", 466560),
            "auth": merged_cfg.get("auth", {"enable": True}),
            "users": merged_cfg.get("users", default_cfg["users"]),
            "make_stream": merged_cfg.get("make_stream", []),
            "categories": merged_cfg.get("categories", []),
            "servers": merged_cfg.get("servers", []),
            "softcam": merged_cfg.get("softcam", []),
            "cas": merged_cfg.get("cas", []),
            "dvb_tune": merged_cfg.get("dvb_tune", []),
            "settings": merged_cfg.get("settings", {}),
            "hls": merged_cfg.get("hls", {}),
        }
        conf_file.write_text(json.dumps(ordered_cfg, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    else:
        conf_file.write_text(json.dumps(default_cfg, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")

    exec_cmd = f"/usr/bin/astrag -c {conf_file}"

    if build_binary:
        print(f"[AstraG] Сборка нативного ELF-бинарника (/opt/astrag/astrag-bin)...")
        try:
            (opt_dir / "astrag-bin").unlink(missing_ok=True)
        except OSError:
            pass
        env = os.environ.copy()
        env["DEBIAN_FRONTEND"] = "noninteractive"
        subprocess.run(
            ["apt-get", "install", "-y", "--no-install-recommends", "python3-venv", "python3-pip", "binutils"],
            env=env,
            check=True,
        )
        with tempfile.TemporaryDirectory(prefix="astrag-build-") as bdir:
            venv_dir = Path(bdir) / "venv"
            subprocess.run([sys.executable, "-m", "venv", "--system-site-packages", str(venv_dir)], check=True)
            pip_bin = venv_dir / "bin" / "pip"
            pyi_bin = venv_dir / "bin" / "pyinstaller"
            subprocess.run([str(pip_bin), "install", "-q", "pyinstaller"], check=True)
            subprocess.run(
                [
                    str(pyi_bin),
                    "--noconfirm",
                    "--clean",
                    "--onefile",
                    "--name",
                    "astrag-bin",
                    "--distpath",
                    str(opt_dir),
                    "--workpath",
                    str(Path(bdir) / "work"),
                    "--specpath",
                    str(bdir),
                    "--paths",
                    str(opt_dir),
                    "--add-data",
                    f"{opt_dir / 'www'}:www",
                    "--hidden-import",
                    "stream_engine",
                    "--hidden-import",
                    "account_security",
                    "--hidden-import",
                    "uvicorn.logging",
                    "--hidden-import",
                    "uvicorn.loops",
                    "--hidden-import",
                    "uvicorn.loops.auto",
                    "--hidden-import",
                    "uvicorn.loops.asyncio",
                    "--hidden-import",
                    "uvicorn.protocols",
                    "--hidden-import",
                    "uvicorn.protocols.http",
                    "--hidden-import",
                    "uvicorn.protocols.http.auto",
                    "--hidden-import",
                    "uvicorn.protocols.http.h11_impl",
                    "--hidden-import",
                    "uvicorn.protocols.websockets",
                    "--hidden-import",
                    "uvicorn.protocols.websockets.auto",
                    "--hidden-import",
                    "uvicorn.lifespan",
                    "--hidden-import",
                    "uvicorn.lifespan.on",
                    "--hidden-import",
                    "uvicorn.lifespan.off",
                    "--hidden-import",
                    "multipart",
                    str(opt_dir / "astra_clone_backend.py"),
                ],
                check=True,
            )
        bin_path = opt_dir / "astrag-bin"
        os.chmod(bin_path, 0o755)
        exec_cmd = f"{bin_path} -c {conf_file}"

    _chown_tree(opt_dir, "astrag")
    _chown_tree(etc_dir, "astrag")
    _chown_tree(var_dir, "astrag")
    os.chmod(conf_file, 0o640)

    unit_lines = [
        "[Unit]",
        f"Description=AstraG Stream & Broadcast Server ({service_name})",
        "After=network-online.target",
        "Wants=network-online.target",
        "",
        "[Service]",
        "Type=simple",
        "User=astrag",
        "Group=astrag",
        "WorkingDirectory=/opt/astrag",
        'Environment="PYTHONUNBUFFERED=1"',
        'Environment="MALLOC_ARENA_MAX=2"',
        f'Environment="ASTRA_CONFIG_FILE={conf_file}"',
        f'Environment="ASTRA_STATE_FILE={conf_file}"',
        'Environment="ASTRA_STATIC_DIR=/opt/astrag/www"',
        f"ExecStart={exec_cmd}",
        "Restart=always",
        "RestartSec=2",
        "LimitNOFILE=65535",
        "",
        "[Install]",
        "WantedBy=multi-user.target",
        "",
    ]
    unit_path = Path(f"/etc/systemd/system/{service_name}.service")
    unit_path.write_text("\n".join(unit_lines), encoding="utf-8")

    subprocess.run(["systemctl", "daemon-reload"], check=False)
    print(f"[AstraG] Сервис '{service_name}' успешно зарегистрирован (порт {port}, конфиг {conf_file}).")
    was_active = (
        subprocess.run(["systemctl", "is-active", "--quiet", f"{service_name}.service"], check=False).returncode == 0
    )
    if auto_start or was_active:
        subprocess.run(["systemctl", "enable", "--now", f"{service_name}.service"], check=False)
        subprocess.run(["systemctl", "restart", f"{service_name}.service"], check=False)
        print(f"[AstraG] Сервис '{service_name}' запущен и добавлен в автозагрузку.")
    else:
        print("Для запуска и добавления в автозагрузку выполните:")
        print(f"  systemctl start {service_name}")
        print(f"  systemctl enable {service_name}")
    return 0


def cmd_remove(argv: list) -> int:
    if os.geteuid() != 0:
        print("Ошибка: команда 'astrag remove' требует прав root (используйте sudo).", file=sys.stderr)
        return 1

    target_arg = None
    purge = False
    for a in argv:
        if a in ("--purge", "-P", "purge"):
            purge = True
        elif not a.startswith("-"):
            target_arg = a

    if target_arg is None:
        service_name = "astrag"
    elif target_arg.isdigit():
        service_name = "astrag" if int(target_arg) == 8000 else f"astrag{target_arg}"
    else:
        service_name = target_arg

    unit_name = f"{service_name}.service"
    subprocess.run(["systemctl", "stop", unit_name], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(["systemctl", "disable", unit_name], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    unit_path = Path(f"/etc/systemd/system/{unit_name}")
    if unit_path.exists():
        unit_path.unlink()
    subprocess.run(["systemctl", "daemon-reload"], check=False)
    subprocess.run(["systemctl", "reset-failed"], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    print(f"[AstraG] Сервис '{service_name}' остановлен и удален из systemd.")

    if purge:
        if target_arg is not None and service_name != "astrag":
            conf_p = Path(f"/etc/astrag/{service_name}.conf")
            if conf_p.exists():
                conf_p.unlink()
            print(f"[AstraG] Конфигурационный файл {conf_p} удален.")
        else:
            for unit_p in Path("/etc/systemd/system").glob("astrag*.service"):
                u_name = unit_p.name
                subprocess.run(["systemctl", "stop", u_name], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                subprocess.run(["systemctl", "disable", u_name], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                unit_p.unlink(missing_ok=True)
            subprocess.run(["systemctl", "daemon-reload"], check=False)
            for d in (Path("/opt/astrag"), Path("/etc/astrag"), Path("/var/lib/astrag"), Path("/var/log/astrag")):
                if d.exists():
                    shutil.rmtree(d, ignore_errors=True)
            subprocess.run(["userdel", "astrag"], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            usr_bin = Path("/usr/bin/astrag")
            if usr_bin.exists():
                try:
                    usr_bin.unlink()
                except OSError:
                    pass
            print("[AstraG] Все файлы (/opt/astrag, /etc/astrag, /var/lib/astrag, /usr/bin/astrag) полностью удалены.")
    return 0


def cmd_reset_password(argv: list) -> int:
    rdir = ensure_runtime_extracted()
    conf_path = Path(os.environ.get("ASTRA_CONFIG_FILE", "/etc/astrag/astrag.conf"))
    pos = []
    i = 0
    while i < len(argv):
        if argv[i] in ("-c", "--config") and i + 1 < len(argv):
            conf_path = Path(argv[i + 1])
            i += 2
        else:
            pos.append(argv[i])
            i += 1
    login = pos[0] if len(pos) >= 1 else "admin"
    password = pos[1] if len(pos) >= 2 else "admin"
    if not conf_path.parent.exists():
        conf_path = rdir / "astrag.conf"
    conf_path.parent.mkdir(parents=True, exist_ok=True)
    data = {}
    if conf_path.exists():
        try:
            raw = conf_path.read_text(encoding="utf-8-sig").strip()
            if raw.startswith("{"):
                data = json.loads(raw)
        except Exception:
            data = {}
    cfg = data.get("config") if isinstance(data.get("config"), dict) else data
    if not isinstance(cfg, dict):
        cfg = {}
    cfg.setdefault("port", 8000)
    cfg.setdefault("host", "0.0.0.0")
    cfg.setdefault("gid", 466560)
    cfg.setdefault("auth", {})["enable"] = True
    users = cfg.setdefault("users", {})
    users[login] = {
        "type": 1,
        "role": "admin",
        "enable": True,
        "password": password,
        "created": int(time.time()),
    }
    cfg.setdefault("make_stream", [])
    cfg.setdefault("categories", [])
    cfg.setdefault("servers", [])
    cfg.setdefault("softcam", [])
    cfg.setdefault("cas", [])
    cfg.setdefault("dvb_tune", [])
    cfg.setdefault("settings", {})
    cfg.setdefault("hls", {})
    conf_path.write_text(json.dumps(cfg, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    os.chmod(conf_path, 0o640)
    print(f"[AstraG] Учетная запись '{login}' (пароль '{password}') сохранена в {conf_path}.")
    return 0


def print_help() -> None:
    print(
        f"AstraG v{VERSION} — Cesbo Astra-compatible MPEG-TS / HLS Broadcast Server\n\n"
        "Использование:\n"
        "  astrag init [port] [name] [--start]    Создать конфиг /etc/astrag/astrag[port].conf и сервис systemd\n"
        "  astrag remove [port|name] [--purge]    Удалить сервис systemd (с --purge удаляет конфиги и файлы)\n"
        "  astrag -c <config> [-p <port>]         Запустить сервер вещания и веб-панель напрямую\n"
        "  astrag reset-password [user] [pass]    Сбросить логин и пароль в /etc/astrag/astrag.conf\n"
        "  astrag -v, --version                   Показать версию AstraG\n"
        "  astrag -h, --help                      Показать эту справку"
    )


def main() -> int:
    _set_proc_name(b"astrag\x00")
    argv = sys.argv[1:]
    if argv:
        cmd = argv[0]
        if cmd in ("-v", "--version", "version"):
            print(f"AstraG {VERSION}")
            return 0
        if cmd in ("-h", "--help", "help"):
            print_help()
            return 0
        if cmd == "init":
            return cmd_init(argv[1:])
        if cmd in ("remove", "uninstall"):
            return cmd_remove(argv[1:])
        if cmd == "purge":
            return cmd_remove(["--purge"] + argv[1:])
        if cmd == "reset-password":
            return cmd_reset_password(argv[1:])

    rdir = ensure_runtime_extracted()
    sys.path.insert(0, str(rdir))
    os.environ.setdefault("ASTRA_STATIC_DIR", str(rdir / "www"))
    if "-c" not in argv and "--config" not in argv and Path("/etc/astrag/astrag.conf").exists():
        os.environ.setdefault("ASTRA_CONFIG_FILE", "/etc/astrag/astrag.conf")
        os.environ.setdefault("ASTRA_STATE_FILE", "/etc/astrag/astrag.conf")

    import astra_clone_backend
    return astra_clone_backend.main()


if __name__ == "__main__":
    raise SystemExit(main())
