[Unit]
Description=Astra-compatible control and IPTV streaming server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=astra-clone
Group=astra-clone
WorkingDirectory=/opt/astra-clone
Environment="PYTHONUNBUFFERED=1"
Environment="PYTHONDONTWRITEBYTECODE=1"
Environment="ASTRA_HOST=0.0.0.0"
Environment="ASTRA_PORT=8000"
Environment="ASTRA_STATIC_DIR=/opt/astra-clone/www"
Environment="ASTRA_STATE_FILE=/var/lib/astra-clone/state.json"
Environment="ASTRA_CONFIG_FILE=/etc/astra-clone/astra-clone.conf"
EnvironmentFile=-/etc/astra-clone/astra-clone.conf
ExecStart=/opt/astra-clone/venv/bin/python /opt/astra-clone/astra_clone_backend.py
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
RuntimeDirectory=astra-clone
RuntimeDirectoryMode=0750
StateDirectory=astra-clone
StateDirectoryMode=0750
UMask=0027
StandardOutput=journal
StandardError=journal
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/astra-clone /run/astra-clone
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
